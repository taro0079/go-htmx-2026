{{define "page:title"}}Users{{end}}

{{define "page:content"}}
<h1>Users</h1>
<table>
    <thead>
        <tr>
            <th>Email</th>
            <th>Created At</th>
        </tr>
    </thead>
    <tbody id="search-results">
        {{template "users:rows" .}}
    </tbody>
</table>
{{end}}

{{define "users:rows"}}
    {{range .}}
    <tr>
        <td>{{ .Email }}</td>
        <td>{{ .CreatedAt }}</td>
    </tr>
    {{end}}
{{end}}

