{{define "page:title"}}New Post{{end}}

{{define "page:content"}}
<h1>New Post</h1>
<form action="/posts" method="post">
    <div name="title">
        <label for="title">Title</label>
        <input name="title">
    </div>

    <div name="content">
        <label for="content">Content</label>
        <input name="content">
    </div>

    <button type="submit">Submit</button>
</form>

{{end}}



