{{define "page:title"}}Posts{{end}}

{{define "page:content"}}
<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Content</th>
        </tr>
    </thead>
    <tbody>
        {{template "posts:rows" .}}
    </tbody>
</table>
{{end}}

{{define "posts:rows"}}
    {{range .}}
    <tr>
        <td>{{ .Title }}</td>
        <td>{{ .Content }}</td>
    </tr>
    {{end}}
{{end}}
