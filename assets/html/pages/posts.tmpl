{{define "page:title"}}Posts{{end}}

{{define "page:content"}}
<input type="search"
       name="query"
       hx-get="/posts/search"
       hx-trigger="input changed delay:300ms, search"
       hx-target="#search-results"
       hx-indicator="#spinner"
       placeholder="Search Posts">

<span id="spinner" class="htmx-indicator">
    検索中...
</span>
<table>
    <thead>
        <tr>
            <th>Title</th>
        </tr>
    </thead>
    <tbody id="search-results">
        {{template "posts:rows" .}}
    </tbody>
</table>
{{end}}

{{define "posts:rows"}}
    {{range .}}
    <tr>
        <td>{{ .Title }}</td>
    </tr>
    {{end}}
{{end}}
